{
  "compilerOptions": {
    "target": "es2018",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "rootDir": ".",
    "types": ["node", "jest", "react", "react-dom"],
    "paths": {
      "client/*": ["client/*"],
      "pages/*": ["pages/*"],
      "server/*": ["server/*"],
      "utils": ["utils/index.ts"],
      "utils/*": ["utils/*"],
      "types": ["types/index.ts"],
      "types/*": ["types/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "typings.d.ts",
    "declarations.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    "scratch",
    "build-service",
    "cache-service"
  ]
}
