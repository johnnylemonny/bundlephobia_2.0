  "scripts": {
    "dev": "cross-env DEBUG='bp:*' NODE_ENV=development nodemon --watch ./server --watch ./utils ./index.ts",
    "build": "cross-env NODE_ENV=production next build --webpack",
    "prebuild": "ts-node bin/generate-sitemap.ts",
    "prestart": "pnpm build",
    "start": "cross-env DEBUG='bp:*' NODE_ENV=production node ./index.js",
    "prod": "pnpm run build && pnpm start",
    "test": "jest",
    "test:watch": "jest --watch",
    "prettier": "prettier --write '**/*.{html,js,json,css,scss,jsx,flow,md,yml,yaml}'",
    "lint": "eslint .",
    "test:full": "pnpm build && cross-env BASIC_AUTH_PASSWORD=test NODE_ENV=production start-server-and-test start http://localhost:5000 jest",
    "deploy": "git branch -D gh-pages && git checkout -b gh-pages && pnpm run build && pnpm run export && cp -R out/* . ",
    "prepare": "husky"
  },
